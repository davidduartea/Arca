DATABASE_URL=postgresql://arca:arca@localhost:5433/arca?schema=public
DIRECT_URL=postgresql://arca:arca@localhost:5433/arca?schema=public

# Base separada para los tests, que la vacían entre casos. El arranque de
# Vitest la crea y le aplica las migraciones; nunca debe apuntar a la de
# desarrollo.
TEST_DATABASE_URL=postgresql://arca:arca@localhost:5433/arca_test?schema=public

# Con qué se firman los tokens. En producción, algo aleatorio y largo:
#   node -e "console.log(require(\"node:crypto\").randomBytes(48).toString(\"base64url\"))"
JWT_SECRET=solo-para-desarrollo-cambiame-por-algo-aleatorio-y-largo

# Cuántos proxies hay delante en los que confiar para deducir la IP de quien
# llama. Cero en local. Detrás de un balanceador, el número de saltos reales.
TRUST_PROXY_HOPS=0
