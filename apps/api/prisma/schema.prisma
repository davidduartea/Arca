// Esquema del libro contable.
//
// Tres tablas y una idea: **el saldo no se guarda en ninguna parte**. Se deriva
// sumando los asientos de la cuenta. Un campo `balance` es un dato duplicado, y
// un dato duplicado acaba desincronizado — con dinero, eso significa que el
// banco y el cliente no están de acuerdo en cuánto hay.
//
// Las tablas y columnas van en snake_case vía @map porque es la convención de
// Postgres, mientras que el cliente de TypeScript las ve en camelCase.

generator client {
  provider = "prisma-client-js"
}

// En Prisma 7 la URL ya no vive aquí: se movió a `prisma.config.ts`. El
// esquema sólo declara con qué motor habla.
// 📖 https://www.prisma.io/docs/guides/upgrade-prisma-orm/v7
datasource db {
  provider = "postgresql"
}

/// Quien abre cuentas y mueve dinero.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Se guarda siempre en minúsculas: `Ana@x.com` y `ana@x.com` son la misma
  /// persona, y sin normalizar el índice único dejaría registrarse dos veces.
  email String @unique

  /// Cómo se llama, tal y como lo escribió.
  ///
  /// Es lo que ve un desconocido al teclear su número de arca antes de mandarle
  /// dinero, y por eso existe: antes se enseñaba el nombre de la cuenta, que es
  /// una etiqueta privada y además no confirma a quién se le manda.
  ///
  /// Sin normalizar y sin índice: dos personas pueden llamarse igual. Quien
  /// distingue es el número.
  name String

  /// El resultado de scrypt con su sal y sus parámetros dentro. Nunca la
  /// contraseña, ni algo de lo que se pueda sacar.
  passwordHash String @map("password_hash")

  /// Sube cada vez que hay que invalidar todo lo firmado hasta ahora.
  ///
  /// El token lleva dentro el valor que tenía al emitirse, y el guardia compara
  /// los dos en cada petición. Subirlo una vez deja fuera a cualquier token
  /// anterior, esté donde esté y le quede lo que le quede de vida.
  tokenVersion Int @default(0) @map("token_version")

  createdAt DateTime @default(now()) @map("created_at")

  accounts Account[]

  @@map("users")
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  /// De quién es la cuenta. Con clave foránea de verdad: hasta ahora era un
  /// uuid suelto que no apuntaba a nada, y una cuenta sin dueño que exista no
  /// es una cuenta, es un agujero.
  ownerId String @db.Uuid @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  /// Lo que ve quien la usa: «Cuenta corriente», «Ahorro».
  name String

  /// El número que se le da a otra persona para poder recibir dinero.
  ///
  /// Doce cifras: cuatro de emisión, siete de cuenta y una de control. El uuid
  /// sigue siendo la clave interna; esto es lo único que una persona ve, dicta
  /// o teclea, porque un uuid no se puede dictar por teléfono.
  ///
  /// La base comprueba el dígito de control con un `CHECK`, igual que comprueba
  /// que los asientos sumen cero: si la regla vive sólo en el código, un
  /// `INSERT` desde otro sitio mete un número que nadie podrá teclear.
  /// El valor por defecto lo pone la base para que un INSERT que no mencione
  /// la columna —una version vieja del codigo, un script— siga funcionando.
  number String @unique @default(dbgenerated("arca_new_number()")) @db.Char(12)

  /// Distingue las cuentas de personas de las del propio sistema.
  ///
  /// Un ingreso desde fuera tiene que salir de algún sitio, o la transacción
  /// no cuadraría a cero. Sale de una cuenta de sistema — el equivalente
  /// contable de «el mundo exterior» — que sí puede quedar en negativo.
  kind AccountKind @default(USER)

  /// Cuándo se cerró, si se cerró.
  ///
  /// Cerrar no borra: los asientos apuntan aquí y son inmutables. Lo que hace
  /// es sacarla de circulación —ni manda ni recibe— dejando su extracto
  /// legible, y se puede deshacer. Las de sistema no se cierran nunca, y eso lo
  /// sujeta un `CHECK` en la base.
  closedAt DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")

  entries Entry[]

  @@index([ownerId])
  @@map("accounts")
}

enum AccountKind {
  USER
  SYSTEM

  @@map("account_kind")
}

/// Un movimiento completo. Agrupa los asientos que se guardan juntos o no se
/// guardan: una transferencia son dos asientos dentro de UNA transacción.
model Transaction {
  id String @id @default(uuid()) @db.Uuid

  /// La clave que manda el cliente para poder reintentar sin duplicar.
  ///
  /// Es única y anulable: única para que dos peticiones con la misma clave no
  /// puedan crear dos transacciones, y anulable porque los movimientos
  /// internos del sistema no vienen de una petición que pueda repetirse.
  idempotencyKey String? @unique @map("idempotency_key")

  description String

  /// Qué transacción corrige ésta, si es una corrección.
  ///
  /// Los asientos son inmutables: un error no se borra ni se edita, se anula
  /// con otra transacción que invierte los importes. Así el histórico cuenta
  /// lo que pasó de verdad, incluido el error.
  reversesId String?      @unique @map("reverses_id") @db.Uuid
  reverses   Transaction? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy Transaction? @relation("Reversal")

  createdAt DateTime @default(now()) @map("created_at")

  entries Entry[]

  @@index([createdAt])
  @@map("transactions")
}

/// Una línea del libro: cuánto se movió en qué cuenta.
///
/// El importe va en **centavos, como entero**. Nunca un decimal: `0.1 + 0.2`
/// no es `0.3` en coma flotante, y en dinero esa diferencia se acumula hasta
/// que los libros dejan de cuadrar.
///
/// El libro es de **una sola moneda: dólares**. No hay columna de divisa a
/// propósito — mezclar monedas dentro de una transacción rompería la suma a
/// cero, porque sumar dólares con euros no da un número con significado. Un
/// libro multidivisa se hace con un libro por moneda y una transacción de
/// cambio que los cruza, no con una columna más.
///
/// El signo lleva la dirección: negativo sale, positivo entra. Los asientos de
/// una misma transacción **suman cero**, y eso lo garantiza la base de datos —
/// ver la migración que instala el trigger diferido.
model Entry {
  id String @id @default(uuid()) @db.Uuid

  transactionId String      @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  amount BigInt

  createdAt DateTime @default(now()) @map("created_at")

  // El índice que sirve al extracto y al cálculo de saldo: las dos consultas
  // filtran por cuenta y ordenan por fecha.
  //
  // El `id` al final no es decorativo. La paginación del extracto ordena por
  // (fecha, id) porque la fecha sola empata — los asientos de una misma
  // transacción comparten `created_at` al milisegundo, ya que en Postgres
  // `now()` devuelve la hora de inicio de la transacción, no la de cada fila.
  // Sin el `id` en el índice, Postgres resuelve el empate con un ordenamiento
  // aparte; con él, el recorrido del índice ya sale ordenado.
  @@index([accountId, createdAt, id])
  @@index([transactionId])
  @@map("entries")
}
